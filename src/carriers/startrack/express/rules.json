{
  "id": "startrack-express",
  "carrier": "startrack",
  "name": "StarTrack Express and Special Services",
  "extends": "startrack-base",
  "spec": { "doc": "StarTrack Label Specifications - Modify Your Own System (MOS) v9", "date": "2020-10-14" },
  "constants": {
    "allowedProducts": ["EXP", "TSE", "RET", "RE2", "APT"]
  },
  "rules": [
    {
      "id": "ST-LOC-02",
      "title": "Express receiver location codes (RC/R1/R2)",
      "description": "Express and Special Services labels print RC AU, R1 blank and R2 the Nearest Depot beside the routing barcode.",
      "obligation": "mandatory",
      "severity": "INFO",
      "category": "startrack-routing",
      "source": { "doc": "MOS v9", "page": 24, "ref": "1.010" },
      "when": { "path": "derived.receiverLocationCodes", "op": "present" },
      "input": "derived.receiverLocationCodes",
      "evidence": ["derived.primaryProductCode"],
      "assert": { "op": "fn", "name": "receiverLocationCodesShown" },
      "onMissing": "manual_review",
      "failStatus": "manual_review"
    }
  ]
}
